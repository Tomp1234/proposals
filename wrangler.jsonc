{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proposals",
  "compatibility_date": "2026-06-09",
  "observability": {
    "enabled": true
  },
  "main": "site-worker/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TrackerDO"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["TrackerDO"]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
